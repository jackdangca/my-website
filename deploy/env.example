# Assignment 4 — cloud environment variables.
# Copy the KEYS into the deployment platform's Environment settings.
# NEVER commit real values. This file is a template only.

# --- Runtime -------------------------------------------------------------
NODE_ENV=production
# Render/Railway/Fly inject PORT automatically. For a local container: 8080.
PORT=8080
# Serve the built React client from Express (same origin, no CORS needed).
SERVE_CLIENT=true
# Comma-separated origins allowed by CORS. For single-origin hosting set it to
# your own public URL; for a split frontend/backend deployment list BOTH.
CLIENT_ORIGIN=https://your-app.onrender.com

# --- MongoDB Atlas (required) -------------------------------------------
# Cluster -> Connect -> Drivers -> copy the SRV connection string and append
# the database name. Network Access must allow the platform (or 0.0.0.0/0
# for a free-tier demo). URL-encode special characters in the password.
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/Portfolio?retryWrites=true&w=majority

# --- Authentication ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<RANDOM_64_CHAR_HEX_SECRET>
JWT_EXPIRES_IN=30d

# --- Bootstrap administrator (seeded once on first start) ---------------
ADMIN_NAME=Portfolio Administrator
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>

# --- Build-time (frontend) ----------------------------------------------
# Leave EMPTY for single-origin hosting (calls /api/... on same origin).
# Set to https://api.example.com for a separately hosted API.
VITE_API_URL=

# --- CI/CD secrets (GitHub repository Settings -> Secrets and variables) --
# JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD  (used by the test job)
# RENDER_DEPLOY_HOOK_URL                   (deploy job; Render -> Deploy Hook)
# DEPLOYED_URL                            (public URL, for post-deploy checks)
# CYPRESS_adminEmail / CYPRESS_adminPassword are derived from ADMIN_* in the
# workflow; no separate secret is required.
