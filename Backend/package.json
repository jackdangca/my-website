{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "MyPortfolio full-stack app: React client + Node/Express/MongoDB backend with JWT auth",
  "main": "server.js",
  "scripts": {
    "server": "nodemon server.js",
    "client": "npm run dev --prefix ../client",
    "dev": "concurrently \"npm run dev --prefix ../client\" \"nodemon server.js\"",
    "start": "node server.js",
    "test": "node --test"
  },
  "keywords": [
    "mern",
    "portfolio",
    "express",
    "mongodb",
    "mongoose",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
